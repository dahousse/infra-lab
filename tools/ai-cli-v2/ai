#!/usr/bin/env python3

import sys
from commands.run import run

def main():
    if len(sys.argv) < 2:
        print("ai v2 - kubectl style AI CLI")
        print("Usage:")
        print("  ai run 'hello'")
        print("  ai run -m phi3:mini 'hello'")
        print("  ai models (next step)")
        print("  ai system (next step)")
        return

    command = sys.argv[1]

    if command == "run":
        prompt = " ".join(sys.argv[2:])
        result = run(prompt)
        print(result)
        return

    print("unknown command:", command)

if __name__ == "__main__":
    main()
